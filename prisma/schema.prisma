generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id          String   @id @default(cuid())
  url         String
  title       String?
  description String?
  imageUrl    String?
  tags        String[]
  createdAt   DateTime @default(now())
  isFavorite  Boolean  @default(false)
}
